#import "../styles.typ": *

= 用語集

#let term(name, body) = block(
  above: 3pt,
  below: 3pt,
  breakable: true,
)[
  #text(font: sans-font, weight: 700, fill: accent-dark)[#name]
  #h(0.6em)
  #body
]

#term[完全ローカル][
  資産を導入した後は外部の推論機能を使わずに会話でき、会話、音声、画像を端末外へ送らないという製品上の条件。
]

#term[実行構成][
  モデルの重み、量子化、会話書式、補助資産、実行環境、設定、端末を一組として扱う推論条件。
]

#term[応答番号][
  一回の応答を識別する単調増加の値。
  生成途中の断片、音声、表情、動作へ同じ値を付け、古い処理の結果を見分ける。
]

#term[量子化][
  重みなどを低いビット幅で表現し、保存量とメモリ転送量を減らす方法。
]

#term[強制アラインメント][
  既知の発話文と対応する音声を照合し、単語や音素の開始と終了を音声上の時刻へ割り当てる処理。
]

#term[VRM][
  人型の骨格、表情、視線などを共通の仕様で表す三次元キャラクター形式。
]

#term[VRMA][
  VRM で定める人型の骨格、表情、視線制御に対応する動作形式。
]

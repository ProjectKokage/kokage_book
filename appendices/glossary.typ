#import "../styles.typ": *

= 用語集

#let term(name, body) = block(
  above: 4pt,
  below: 4pt,
  breakable: false,
)[
  #grid(
    columns: (35mm, 1fr),
    column-gutter: 5mm,
    align: (left + top, left + top),
    text(font: sans-font, size: 9.2pt, weight: 700, fill: accent-dark)[#name],
    block[
      #set text(size: 9.3pt)
      #set par(first-line-indent: 0em, leading: 0.6em, spacing: 0em)
      #body
    ],
  )
]

#term[完全ローカル][
  必要なアセットを導入した後の通常の会話が端末内だけで完結し、入力や会話の内容を端末外へ送らない構成。
  通信は、利用者が明示的に始めたアセットの取得と更新に限る（序章）。
]

#term[実行構成][
  モデルの重み、量子化、チャットテンプレート、補助ファイル、推論ランタイム、設定、端末を一組として扱う推論条件。
  どれか一つを変えたら、実測と動作試験の適用範囲を見直す（第 1 章）。
]

#term[推論ランタイム][
  モデルファイルを読み込み、CPUやGPUで推論を実行するソフトウェア一式。
  推論ランタイムのバージョンと、計算を担うバックエンドも実行構成に含める（第 1 章）。
]

#term[量子化][
  重みを少ないビット数で表し、ファイル容量とメモリ転送量を減らす方法。
  方式を変えたモデルは別の実行構成として検証する（第 1 章）。
]

#term[チャットテンプレート][
  システム指示と会話履歴を、モデルが学習した区切りに合わせて組み立てる書式。
  こかげは重みに埋め込まれた書式を検査して使う（第 1 章）。
]

#term[入力処理][
  回答の生成に先立ち、入力トークンをまとめて評価する工程。
  履歴が長いほど所要時間が増える（第 1 章）。
]

#term[逐次生成][
  入力処理の結果を使い、回答のトークンを一つずつ生成する工程。
  この速度だけでは利用者の待ち時間を説明できない（第 1 章）。
]

#term[内部推論][
  一部のモデルが回答前に生成する、画面へ出さない推論文。
  回答とは別の予算を立て、表示、履歴、読み上げ、身体制御へ渡さない（第 1 章）。
]

#term[制御記法][
  モデルが、本文とは別に表情、動作、声を指定するための記法。
  固定語彙だけを受理し、型付きの値へ変換した後で実行する（第 1 章、付録C）。
]

#term[音声区間検出][
  マイク音声から発話の始まりと終わりを検出する処理（VAD）。
  入力側の単位であり、出力側の読み上げ区間とは別である（第 2 章）。
]

#term[読みの解析][
  読み上げる文字列を、音声合成が受け取る音素の列へ変換する処理（G2P）。
  音素の対応関係を明示し、合成側のトークン表と照合する（第 2 章）。
]

#term[音声カスケード][
  音声区間検出、音声認識、言語モデル、読みの解析、音声合成を別々の部品として直列につなぐ構成。
  各部品を個別に差し替えられる。
  音声部品が失敗した場合は文字会話へ戻し、言語モデルが失敗した場合は入力を保持して再試行する（第 2 章、第 4 章）。
]

#term[実時間係数][
  音声1秒分の生成に何秒かかるかを示す比（RTF）。
  平均が1を超える構成では、十分な音声を先に生成しておかないと、途切れずに逐次再生を続けられない（第 2 章）。
]

#term[VRM][
  人型の骨格、表情、視線などを共通仕様で表す3Dアバター形式。
  実際に使える機能は個々のファイルごとに調べる（第 3 章）。
]

#term[VRMA][
  VRMの人型骨格に対応する動作ファイル形式。
  外部から採用するときは、容量、ハッシュ値、トラック、移動範囲を検査する（第 3 章）。
]

#term[層][
  立ち姿、待機、発話中の揺れ、単発動作などを役割ごとに分けて合成する単位。
  上位の動作が使う骨では、下位の層の影響を抑える（第 3 章）。
]

#term[応答ID][
  一回の応答と、それに属する非同期の結果を識別する単調増加の値。
  現在の応答IDと一致する結果だけを採用し、停止時は後始末より先に失効させる（第 4 章）。
]

#term[単一解析器][
  一つの返答を一度だけ解析し、表示文、読み上げ区間、表情や動作を表す型付きの値へ分ける処理。
  生の制御記法を後段で読み直さない（第 4 章）。
]

#term[読み上げ区間][
  単一解析器が区切りを確定し、音声合成へ渡せる文のまとまり。
  表情、動作、声の指定もこの単位へ結び付く（第 4 章）。
]

#term[型付きの値][
  固定語彙の名前を検査し、アプリが定めた選択肢の一つへ変換して作る値。
  モデルが出した制御記法の生の文字列や数値を、音声合成の制御やキャラクター描画へ直接渡さないために使う（第 1 章、第 4 章）。
]

#term[再生位置][
  音声出力が、再生中の音声データをどこまで消費したかを示す位置。
  口形、表情、動作を進める時刻基準に使うが、実際に音が出る時刻そのものは保証しない（第 3 章、第 4 章）。
]

#term[時刻基準][
  口形、表情、動作を進める基準。
  こかげは音声出力が消費した再生位置だけを使う（第 4 章）。
]

#term[回帰試験][
  既知の入力と結果を使い、変更後も決めた振る舞いが保たれるかを調べる試験。
  試験用の部品で完了順を制御した確認も、限定した課題での制御記法の確認も、実際のモデルや端末の一般性能は証明しない（第 1 章、第 4 章）。
]

#term[動作試験][
  実際のモデルと推論ランタイムを使い、想定した処理がその構成で動くかを確かめる試験。
  別のモデル、端末、ビルド形態へ結果を流用しない（第 1 章、第 4 章）。
]

#term[実測][
  対象の端末と構成で、時間、メモリ使用量、出力などを測った記録。
  測定条件と範囲が欠けた値は、別の構成の性能を示さない（第 1 章、第 4 章）。
]

#term[見直し条件][
  現在の設計判断を見直すために、先に定めておく確認項目。
  新しい部品が対象端末での停止処理と縮退に対応し、待ち時間の条件と配布条件を満たすかを具体的に書く（第 1 章から第 3 章）。
]

#term[縮退][
  部品が失敗したとき、その部品が担う機能だけを外し、残りの機能で会話を続ける振る舞い。
  音声処理や身体表現に失敗しても文字会話を残す（第 4 章）。
]
